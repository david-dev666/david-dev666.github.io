---
import { siteConfig } from "../config";
import "../styles/global.css";

const { frontmatter } = Astro.props;

// 日期格式化为 YYYY-MM-DD（frontmatter.date 可能被 YAML 解析为 Date 对象）
const fmtDate = (d: any) => {
  const date = new Date(d);
  return date.toISOString().slice(0, 10);
};
const dateStr = fmtDate(frontmatter.date);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={frontmatter.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
    <title>{frontmatter.title} - {siteConfig.name}</title>
  </head>
  <body class="bg-white">
    <main class="pb-12">
      <article class="max-w-2xl mx-auto px-6 pt-8">
        <!-- HOME按钮 -->
        <div class="mb-6">
          <a href="/" class="text-gray-600 hover:text-amber-700 transition-colors font-medium text-lg tracking-wide">
            HOME
          </a>
        </div>

        <!-- 标题 + 日期 -->
        <header class="mb-8">
          <h1 class="font-serif font-bold text-2xl md:text-3xl text-black mb-2 leading-snug">
            {frontmatter.title}
          </h1>
          <time class="text-sm text-gray-400 font-sans">
            {dateStr}
          </time>
        </header>

        <div class="essay-content">
          <slot />
        </div>
      </article>
    </main>

    <footer class="border-t border-gray-100 py-6">
      <div class="max-w-2xl mx-auto px-6 text-center text-gray-500 text-sm">
        © {new Date().getFullYear()} {siteConfig.name}
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .essay-content {
    color: #1f2937;
    line-height: 1.8;
    font-family: 'Noto Serif SC', 'Times New Roman', serif;
    font-weight: 400;
  }

  /* 标题 */
  .essay-content h1,
  .essay-content h2,
  .essay-content h3 {
    font-family: 'Noto Serif SC', 'Times New Roman', serif;
    color: #000000;
    font-weight: 600;
  }

  .essay-content h2 {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .essay-content h3 {
    font-size: 1.05rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  /* 段落 */
  .essay-content p {
    margin-bottom: 1rem;
    font-size: 1.0625rem;
    text-align: justify;
    text-justify: inter-ideograph;
  }

  /* 列表 */
  .essay-content ul,
  .essay-content ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .essay-content li {
    margin-bottom: 0.375rem;
  }

  .essay-content ul {
    list-style: disc;
  }

  .essay-content ol {
    list-style: decimal;
  }

  /* 链接 */
  .essay-content a {
    color: #4b5563;
    text-decoration: underline;
    text-decoration-color: #d1d5db;
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  .essay-content a:hover {
    color: #111827;
    text-decoration-color: #111827;
  }

  /* 加粗 */
  .essay-content strong {
    color: #000000;
    font-weight: 600;
  }

  /* 引用 */
  .essay-content blockquote {
    border-left: 3px solid #e5e7eb;
    padding-left: 1rem;
    margin: 1.25rem 0;
    color: #6b7280;
    font-style: italic;
  }

  /* 行内代码 */
  .essay-content code:not(pre code) {
    color: #b45309;
    padding: 0 0.15rem;
    font-size: 0.9em;
    font-family: 'Menlo', 'Monaco', 'Consolas', monospace;
  }

  /* 代码块 */
  .essay-content pre {
    background: #f5f0e8 !important;
    border-radius: 0.375rem;
    padding: 0.875rem;
    overflow-x: auto;
    margin: 1rem 0;
    border: 1px solid #dcd2c3;
  }

  .essay-content pre code {
    background: transparent !important;
    color: #24292e !important;
    padding: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    font-family: 'Menlo', 'Monaco', 'Consolas', monospace;
  }

  .essay-content .astro-code {
    background: #f5f0e8 !important;
  }

  /* 分割线 */
  .essay-content hr {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 2rem 0;
  }

  /* 表格 */
  .essay-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.9rem;
    display: block;
    overflow-x: auto;
  }

  .essay-content th,
  .essay-content td {
    padding: 0.3rem 1rem;
    text-align: center;
    border: 1px solid #e5e7eb;
  }

  .essay-content th {
    font-weight: 600;
    color: #111827;
    background-color: #f9fafb;
  }

  .essay-content td {
    color: #374151;
  }

  .essay-content tbody tr:hover {
    background: #f9fafb;
  }

  .essay-content td code,
  .essay-content th code {
    font-size: 0.85em;
    background: #f3e8ff;
    color: #7e22ce;
    padding: 0.1rem 0.35rem;
    border-radius: 0.2rem;
  }

  /* KaTeX */
  .essay-content .katex {
    font-size: 1em;
  }

  .essay-content .katex-display {
    margin: 1rem 0;
    overflow-x: auto;
    overflow-y: hidden;
    text-align: center;
  }

  .essay-content .katex-display > .katex {
    white-space: nowrap;
  }

  /* 公式包裹层 */
  .math-block {
    text-align: center;
    overflow-x: auto;
    overflow-y: hidden;
    margin: 1rem 0;
  }
  .math-block p {
    display: inline-block;
    text-align: left;
    white-space: nowrap;
  }

  /* 信息卡片（讨论、前置知识等） */
  .essay-content .info-block {
    margin: 1.25rem 0;
    border: 1px solid #e0e7ff;
    border-radius: 0.5rem;
    background: #f8faff;
    overflow: hidden;
  }

  .essay-content .info-block-title {
    padding: 0.5rem 1rem;
    background: #eef2ff;
    border-bottom: 1px solid #e0e7ff;
    font-weight: 600;
    font-size: 0.95rem;
    color: #374151;
  }

  .essay-content .info-block-content {
    padding: 0.75rem 1rem;
  }

  .essay-content .info-block-content > p:first-child {
    margin-top: 0;
  }

  .essay-content .info-block-content > p:last-child {
    margin-bottom: 0;
  }
</style>
