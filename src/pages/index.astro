                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                  
                  <p class="text-gray-500 text-base md:text-lg leading-relaxed">
                    {project.description}
                  </p>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Paper Reading -->
        <section>
