            </a>
            
            <a 
              href="/paper_reading/pixelarena" 
              class="home-card group block p-5 sm:p-6 rounded-2xl border border-gray-200/80 hover:border-gray-300 hover:bg-gray-50/70 transition-all duration-300"
            >
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-1">
