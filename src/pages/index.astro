---
import { siteConfig } from "../config";
import "../styles/global.css";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;

// 自动收集 essays 下的随笔，取最新 3 篇
const essays = Object.entries(
  import.meta.glob("./essays/*.md", { eager: true })
).map(([path, mod]: [string, any]) => {
  const { frontmatter } = mod;
  return {
    href: path.replace(/^\.\//, "/").replace(/\.md$/, ""),
    title: frontmatter.title,
    date: frontmatter.date,
    description: frontmatter.description,
  };
});
essays.sort((a, b) => (new Date(a.date) < new Date(b.date) ? 1 : -1));
const latestEssays = essays.slice(0, 3);
const olderEssays = essays.slice(3);

const fmtDate = (d: any) => {
  const date = new Date(d);
  return date.toISOString().slice(0, 10);
};
---

<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={siteConfig.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{siteConfig.name} - {siteConfig.title}</title>
  </head>
  
  <body class="bg-white text-gray-900 antialiased selection:bg-purple-100 selection:text-purple-900">
    
    <div class="max-w-4xl mx-auto px-6 py-16 md:px-10 md:py-20">
      
      <!-- Header -->
      <header class="mb-20 space-y-5">
        <h1 class="text-5xl md:text-6xl font-serif font-semibold tracking-tight">
          <span class="text-black">{siteConfig.name}</span>
        </h1>
        <div class="h-px w-14 bg-purple-500"></div>
        <p class="text-base md:text-lg text-gray-500 leading-relaxed max-w-lg">
          视觉语言模型与深度学习
        </p>
      </header>

      <main class="space-y-20">

        <!-- Essays -->
        {latestEssays.length > 0 && (
          <section>
            <div class="mb-8">
              <h2 class="text-sm font-semibold tracking-[0.16em] text-gray-400 uppercase font-sans">
                Essays
              </h2>
            </div>

            <div class="grid gap-3">
              {latestEssays.map((essay) => (
                <a
                  href={essay.href}
                  class="home-card group block p-5 sm:p-6 rounded-2xl border border-gray-200/80 hover:border-gray-300 hover:bg-gray-50/70 transition-all duration-300"
                >
                  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-1">
                    <span class="font-serif font-bold text-xl md:text-2xl text-gray-900 group-hover:text-purple-700 transition-colors">
                      {essay.title}
                      <span class="inline-block opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ml-1">→</span>
                    </span>

                    <div class="flex flex-wrap gap-2 mt-2 sm:mt-0">
                      <span class="px-2.5 py-1 bg-gray-100/80 text-gray-500 rounded-full text-xs font-medium tracking-wide group-hover:bg-white group-hover:text-gray-700 transition-colors">
                        {fmtDate(essay.date)}
                      </span>
                    </div>
                  </div>

                  <p class="text-gray-500 text-base md:text-lg leading-relaxed">
                    {essay.description}
                  </p>
                </a>
              ))}
            </div>

            {olderEssays.length > 0 && (
              <details class="essay-archive mt-2">
                <summary class="flex w-full cursor-pointer list-none justify-center py-5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-300 [&::-webkit-details-marker]:hidden">
                  <span class="inline-flex min-h-12 items-center gap-2.5 rounded-full border border-gray-200 bg-gray-50 px-8 font-sans text-base font-medium text-gray-700 shadow-sm transition-all duration-200 hover:border-gray-300 hover:bg-gray-100 hover:shadow">
                    <span>更多</span>
                    <svg class="essay-archive-chevron h-4 w-4 shrink-0 text-gray-500 transition-transform duration-200" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="m3.5 6 4.5 4 4.5-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </summary>

                <div class="essay-archive-list grid gap-3 pb-4">
                  {olderEssays.map((essay) => (
                    <a
                      href={essay.href}
                      class="home-card group block rounded-2xl border border-gray-200/80 p-5 sm:p-6 transition-all duration-300 hover:border-gray-300 hover:bg-gray-50/70"
                    >
                      <div class="flex flex-col gap-2 mb-1 sm:flex-row sm:items-baseline sm:justify-between">
                        <span class="font-serif font-bold text-xl md:text-2xl text-gray-900 group-hover:text-purple-700 transition-colors">
                          {essay.title}
                          <span class="inline-block opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ml-1">→</span>
                        </span>

                        <div class="flex flex-wrap gap-2 mt-2 sm:mt-0">
                          <span class="px-2.5 py-1 bg-gray-100/80 text-gray-500 rounded-full text-xs font-medium tracking-wide group-hover:bg-white group-hover:text-gray-700 transition-colors">
                            {fmtDate(essay.date)}
                          </span>
                        </div>
                      </div>

                      {essay.description && (
                        <p class="text-gray-500 text-base md:text-lg leading-relaxed">
                          {essay.description}
                        </p>
                      )}
                    </a>
                  ))}
                </div>
              </details>
            )}
          </section>
        )}

        <!-- Projects -->
        {hasProjects && (
          <section>
